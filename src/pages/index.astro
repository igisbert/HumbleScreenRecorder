---
import Layout from "../layouts/Layout.astro";

import Bento from "../components/Bento.astro";
import Dialog from "../components/Dialog.astro";
import SideMenu from "../components/SideMenu.astro";
---

<Layout title="Humble Screen Recorder">
  <header>
    <div>
      <h1 class="title">Humble Screen Recorder</h1>
    </div>
  </header>
  <main>
    <div class="container">
      <Bento />
      <div class="background-beauty"></div>
    </div>
  </main>
  <footer>
    <div>Sin cuentas · Sin nube · Sin instalar nada</div>
  </footer>
  <Dialog />
  <SideMenu />
</Layout>

<script src="../assets/screenrecorder.js"></script>
<script src="../assets/showDialog.js"></script>
