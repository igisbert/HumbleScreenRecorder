<div class="container">
    <h4>Elige el formato</h4>
	<form>
		<label>
			<input type="radio" name="video-format" value="webmvp9" checked>
			<span>WebM <div class="small">(recomendado)</div></span>
		</label>
		<label>
			<input type="radio" name="video-format" value="webmav1">
			<span>WebM AV1</span>
		</label>
		<label>
			<input type="radio" name="video-format" value="webmh264">
			<span>WebM H264</span>
		</label>
	</form>
</div>



<style>


/* From Uiverse.io by Pradeepsaranbishnoi */ 
.container form {
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  user-select: none;
}

.container label {
  display: flex;
  cursor: pointer;
  font-weight: 500;
  position: relative;
  overflow: hidden;
  margin-bottom: 0.375em;
}

.container  label input {
  position: absolute;
  left: -9999px;
}

.container label input:checked + span {
  background-color: var(--button-body-color);
  color: white;
}

.container label input:checked + span:before {
  box-shadow: inset 0 0 0 0.4375em var(--recording-color);
}

.container label span {
  display: flex;
  align-items: center;
  padding: 0.375em 0.75em 0.375em 0.375em;
  border-radius: 99em;
  transition: 0.25s ease;
  color: #f3f3f3;
}

.container label span:hover {
  background-color: var(--recording-color);
}

.container label span:before {
  display: flex;
  flex-shrink: 0;
  content: "";
  background-color: #fff;
  width: 1.5em;
  height: 1.5em;
  border-radius: 50%;
  margin-right: 0.375em;
  transition: 0.25s ease;
}

.small{
  font-size: 0.75rem;
  display: inline-flex;
  margin-left: .5rem;
}


</style>