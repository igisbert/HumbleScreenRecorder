---
export interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span class="underline">{text}</span>

<style>
  .underline {
    position: relative;
  }
  .underline::after {
    content: "";
    position: absolute;
    bottom: -18px;
    width: 110%;
    height: 0.5rem;
    transform: translateX(-95%) rotate(358deg) skewX(315deg);
    background: var(--lines-color);
  }
</style>
