---
import Switch from "./Switch.astro";
import TrimTimeline from "./TrimTimeline.astro";
---

<div class="side-menu" id="video-menu">
  <button id="close-menu">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="icon icon-tabler icons-tabler-filled icon-tabler-square-rounded-x"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M12 2l.324 .001l.318 .004l.616 .017l.299 .013l.579 .034l.553 .046c4.785 .464 6.732 2.411 7.196 7.196l.046 .553l.034 .579c.005 .098 .01 .198 .013 .299l.017 .616l.005 .642l-.005 .642l-.017 .616l-.013 .299l-.034 .579l-.046 .553c-.464 4.785 -2.411 6.732 -7.196 7.196l-.553 .046l-.579 .034c-.098 .005 -.198 .01 -.299 .013l-.616 .017l-.642 .005l-.642 -.005l-.616 -.017l-.299 -.013l-.579 -.034l-.553 -.046c-4.785 -.464 -6.732 -2.411 -7.196 -7.196l-.046 -.553l-.034 -.579a28.058 28.058 0 0 1 -.013 -.299l-.017 -.616c-.003 -.21 -.005 -.424 -.005 -.642l.001 -.324l.004 -.318l.017 -.616l.013 -.299l.034 -.579l.046 -.553c.464 -4.785 2.411 -6.732 7.196 -7.196l.553 -.046l.579 -.034c.098 -.005 .198 -.01 .299 -.013l.616 -.017c.21 -.003 .424 -.005 .642 -.005zm-1.489 7.14a1 1 0 0 0 -1.218 1.567l1.292 1.293l-1.292 1.293l-.083 .094a1 1 0 0 0 1.497 1.32l1.293 -1.292l1.293 1.292l.094 .083a1 1 0 0 0 1.32 -1.497l-1.292 -1.293l1.292 -1.293l.083 -.094a1 1 0 0 0 -1.497 -1.32l-1.293 1.292l-1.293 -1.292l-.094 -.083z"
        fill="currentColor"
        stroke-width="0"></path></svg
    >
  </button>
  <h2>Previsualización y descarga</h2>
  <div class="video-wrapper" id="video-wrapper">
    <video id="preview-video" src=""></video>
    <div class="video-controls">
      <button id="play-button" aria-label="Reproducir">
        <svg
          id="icon-play"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M6 4l12 8l-12 8z"
            fill="currentColor"
            stroke-width="0"></path></svg
        >
        <svg
          id="icon-pause"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          hidden
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M7 5h4v14h-4zm6 0h4v14h-4z"
            fill="currentColor"
            stroke-width="0"></path></svg
        >
      </button>
      <input
        type="range"
        id="seek-bar"
        min="0"
        max="0"
        step="0.01"
        value="0"
        aria-label="Posición de reproducción"
      />
      <span id="playback-time">0:00 / 0:00</span>
    </div>
  </div>
  <TrimTimeline />
  <div class="export-options">
    <span class="export-label">Exportar en MP4</span>
    <Switch id="export-mp4" />
  </div>
  <a id="download-button" class="download-button">Descargar</a>
</div>

<style>
  .side-menu {
    position: fixed;
    top: 50%;
    left: 1rem;
    width: min(90%, 1400px);
    height: 90%;
    background-color: var(--dropdown-color);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* transform: translateX(100%); */
    transition: 0.5s transform ease-in-out;
    z-index: 100;
    transform: translateX(calc(-100% - 2rem)) translateY(-50%);
    border-top-left-radius: 1rem;
    border-bottom-left-radius: 1rem;
    padding: 1rem 2rem;
    box-shadow: 7px 7px 20px 9px #000000ad;
    border-radius: 1rem;
  }

  #close-menu {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    border: none;
    background: none;
    font-size: 2rem;
    color: var(--text-color);
    cursor: pointer;
    padding: 0;
  }

  #close-menu svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  .side-menu h2 {
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .side-menu video {
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
  }

  .video-wrapper {
    position: relative;
    width: 100%;

    &:hover .video-controls,
    &:not(.is-playing) .video-controls {
      opacity: 1;
    }
  }

  .video-controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.75rem 1rem 0.6rem;
    background: linear-gradient(#00000000, #000000db);
    border-bottom-left-radius: 1rem;
    border-bottom-right-radius: 1rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  #play-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--text-color);
    cursor: pointer;

    svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    &:hover {
      scale: 1.12;
    }
  }

  #seek-bar {
    flex-grow: 1;
    appearance: none;
    -webkit-appearance: none;
    height: 5px;
    background-color: #ffffff40;
    border-radius: 3px;
    cursor: pointer;

    &::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      border: none;
      background: var(--text-color);
      box-shadow: 0 1px 4px #000000a0;
    }

    &::-moz-range-thumb {
      width: 13px;
      height: 13px;
      border-radius: 50%;
      border: none;
      background: var(--text-color);
      box-shadow: 0 1px 4px #000000a0;
    }
  }

  #playback-time {
    font-size: 0.9rem;
    color: var(--text-color);
    letter-spacing: 0.5px;
    min-width: 7ch;
    text-align: right;
  }

  .download-button {
    border: none;
    border-radius: 4rem;
    background-color: var(--button-body-color);
    cursor: pointer;
    box-shadow: 4px 4px 7px 3px #00000073;
    transition: transform 0.3s ease;
    color: var(--button-color);
    text-align: center;
    font-size: 2rem;
    padding: 2rem 3rem;
    margin-top: 2rem;
    text-decoration: none;
  }

  .download-button:hover {
    background-color: var(--primary_color);
    transform: scale(1.1);
  }

  .export-options {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .export-label {
    color: var(--text-color);
    font-size: 1.05rem;
  }
</style>

<script>
  import { formatTime } from "../assets/formatTime.js";
  import {
    ALL_FORMATS,
    BlobSource,
    BufferTarget,
    Conversion,
    Input,
    Mp4OutputFormat,
    Output,
    WebMOutputFormat,
  } from "mediabunny";

  const videoMenu = document.querySelector("#video-menu") as HTMLElement;
  const closeButton = document.querySelector("#close-menu") as HTMLButtonElement;
  const video = document.querySelector("#preview-video") as HTMLVideoElement;
  const downloadButton = document.querySelector(
    "#download-button"
  ) as HTMLAnchorElement;
  const timeline = document.querySelector("#trim-timeline") as HTMLElement;
  const mp4Switch = document.querySelector(
    "#export-mp4"
  ) as HTMLInputElement;
  const wrapper = document.querySelector("#video-wrapper") as HTMLDivElement;
  const playButton = document.querySelector(
    "#play-button"
  ) as HTMLButtonElement;
  const iconPlay = document.querySelector("#icon-play") as SVGElement;
  const iconPause = document.querySelector("#icon-pause") as SVGElement;
  const seekBar = document.querySelector("#seek-bar") as HTMLInputElement;
  const playbackTime = document.querySelector(
    "#playback-time"
  ) as HTMLSpanElement;

  let trim: { start: number; end: number } = { start: 0, end: Infinity };
  let exporting = false;

  const isFullRange = () =>
    !Number.isFinite(trim.end) ||
    (trim.start <= 0.05 && trim.end >= video.duration - 0.05);

  const syncPlaybackUI = () => {
    const playing = !video.paused && !video.ended;

    wrapper.classList.toggle("is-playing", playing);
    playButton.setAttribute(
      "aria-label",
      playing ? "Pausar" : "Reproducir"
    );
    iconPlay.hidden = playing;
    iconPause.hidden = !playing;
  };

  const renderPlaybackTime = () => {
    const total = Number.isFinite(trim.end) ? trim.end : 0;
    playbackTime.textContent = `${formatTime(video.currentTime)} / ${formatTime(total)}`;
    seekBar.value = String(video.currentTime);
  };

  timeline.addEventListener("trimchange", (event) => {
    trim = (event as CustomEvent<{ start: number; end: number }>).detail;

    seekBar.min = String(trim.start);
    if (Number.isFinite(trim.end)) seekBar.max = String(trim.end);
    renderPlaybackTime();

    if (!exporting) {
      downloadButton.textContent = isFullRange()
        ? "Descargar"
        : "Descargar recorte";
    }
  });

  video.addEventListener("loadedmetadata", () => {
    trim = { start: 0, end: Infinity };
    if (!exporting) downloadButton.textContent = "Descargar";
  });

  const triggerDownload = (url: string, fileName: string) => {
    const link = document.createElement("a");
    link.href = url;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();
  };

  closeButton.addEventListener("click", () => {
    videoMenu.classList.remove("video-container-visible");
  });

  const togglePlay = () => {
    if (video.paused) video.play();
    else video.pause();
  };

  playButton.addEventListener("click", togglePlay);
  video.addEventListener("click", togglePlay);

  video.addEventListener("play", syncPlaybackUI);
  video.addEventListener("pause", syncPlaybackUI);
  video.addEventListener("ended", syncPlaybackUI);
  video.addEventListener("timeupdate", renderPlaybackTime);
  seekBar.addEventListener("input", () => {
    video.currentTime = Number(seekBar.value);
  });

  downloadButton.addEventListener("click", async (event) => {
    if (exporting || !video.src) {
      event.preventDefault();
      return;
    }

    if (isFullRange() && !mp4Switch.checked) return;

    event.preventDefault();
    exporting = true;
    const originalLabel = downloadButton.textContent;

    try {
      const isTrimmed = !isFullRange();
      downloadButton.textContent = "Preparando…";

      const sourceBlob = await fetch(video.src).then((response) =>
        response.blob(),
      );

      const input = new Input({
        source: new BlobSource(sourceBlob),
        formats: ALL_FORMATS,
      });
      const output = new Output({
        format: mp4Switch.checked
          ? new Mp4OutputFormat()
          : new WebMOutputFormat(),
        target: new BufferTarget(),
      });
      const extension = mp4Switch.checked ? "mp4" : "webm";
      const mimeType = mp4Switch.checked ? "video/mp4" : "video/webm";

      const conversion = await Conversion.init({
        input,
        output,
        ...(isTrimmed ? { trim: { start: trim.start, end: trim.end } } : {}),
      });
      conversion.onProgress = (progress) => {
        downloadButton.textContent = `Exportando… ${Math.round(progress * 100)}%`;
      };
      await conversion.execute();

      const buffer = output.target.buffer;
      if (!buffer) throw new Error("La conversión no generó ningún dato");

      const exportedURL = URL.createObjectURL(
        new Blob([buffer], { type: mimeType }),
      );
      const baseName = (downloadButton.download ?? "grabacion.webm").replace(
        /\.webm$/,
        "",
      );
      const fileName = isTrimmed
        ? `${baseName}-recortado.${extension}`
        : `${baseName}.${extension}`;

      triggerDownload(exportedURL, fileName);
      setTimeout(() => URL.revokeObjectURL(exportedURL), 10_000);
    } catch (error) {
      console.error("Error al recortar el vídeo: ", error);
      downloadButton.textContent = "Error, inténtalo de nuevo";
    } finally {
      exporting = false;
      setTimeout(() => {
        downloadButton.textContent = originalLabel;
      }, 1500);
    }
  });
</script>
