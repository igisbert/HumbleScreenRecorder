---
interface Props {
  title: string;
}

const { title } = Astro.props;

import "../assets/styles.css";

const SITE_URL = "https://humblescreenrecorder.pages.dev";
const OG_IMAGE_PATH = "/og-image.png";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Humble Screen Recorder - Graba tu pantalla desde el navegador: pestaña, aplicación o escritorio completo. Recorta el vídeo y descárgalo en WebM o MP4. Sin cuentas, sin nube."
    />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={SITE_URL} />
    <meta property="og:title" content="Humble Screen Recorder" />
    <meta
      property="og:description"
      content="Graba tu pantalla desde el navegador y recorta el vídeo sin salir de la web. Sin cuentas, sin nube, sin instalar nada."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}${OG_IMAGE_PATH}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Humble Screen Recorder" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Humble Screen Recorder" />
    <meta
      name="twitter:description"
      content="Graba tu pantalla desde el navegador y recorta el vídeo sin salir de la web. Sin cuentas, sin nube, sin instalar nada."
    />
    <meta name="twitter:image" content={`${SITE_URL}${OG_IMAGE_PATH}`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
